node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/.env*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
vite.config.*.timestamp-*

